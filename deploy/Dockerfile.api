# syntax=docker/dockerfile:1
# =============================================================================
# API del turnero (NestJS) + toolchain para generar el APK del visualizador.
# =============================================================================

# ------------------------- etapa 1: build -------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app

# Manifiestos + fuentes de shared (el `prepare` del root compila @turnero/shared).
COPY package.json package-lock.json ./
COPY packages/shared packages/shared
COPY apps/api/package.json apps/api/
COPY apps/kiosk/package.json apps/kiosk/
COPY apps/cashier/package.json apps/cashier/
COPY apps/display/package.json apps/display/

RUN npm ci

COPY apps/api apps/api

RUN npm run build --workspace @turnero/api \
 && npm prune --omit=dev

# ------------------------- etapa 2: runtime -------------------------
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    API_PORT=3001 \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_HOME=/opt/android-sdk \
    GRADLE_USER_HOME=/gradle-cache

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openjdk-17-jdk-headless \
      unzip \
      curl \
      ca-certificates \
      default-mysql-client \
 && rm -rf /var/lib/apt/lists/*

# Android SDK (platform-tools + platform 35 + build-tools 35) para `gradlew assembleDebug`.
RUN set -eux; \
    mkdir -p "$ANDROID_SDK_ROOT/cmdline-tools"; \
    curl -fsSL -o /tmp/cmdline-tools.zip \
      https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip; \
    unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_SDK_ROOT/cmdline-tools"; \
    mv "$ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools" "$ANDROID_SDK_ROOT/cmdline-tools/latest"; \
    rm -f /tmp/cmdline-tools.zip; \
    yes | "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null; \
    "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" \
      "platform-tools" "platforms;android-35" "build-tools;35.0.0"; \
    rm -rf "$ANDROID_SDK_ROOT/.temp" "$ANDROID_SDK_ROOT/.knownPackages"

ENV PATH="$PATH:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools"

WORKDIR /app
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/shared packages/shared
COPY --from=build /app/apps/api apps/api

# Proyecto Android del visualizador (lo compila el modulo /api/apk).
COPY apps/display-android apps/display-android
RUN chmod +x apps/display-android/gradlew

# cwd = apps/api para que printer.service resuelva public/media/imagenes.
WORKDIR /app/apps/api

EXPOSE 3001
CMD ["node", "dist/main.js"]
