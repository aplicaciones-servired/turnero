# syntax=docker/dockerfile:1
# =============================================================================
# Frontends (kiosco, caja y pantalla) compilados y servidos por nginx.
#   /          -> kiosco
#   /caja/     -> cashier
#   /pantalla/ -> display
# =============================================================================

# ------------------------- etapa 1: build -------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared packages/shared
COPY apps/api/package.json apps/api/
COPY apps/kiosk/package.json apps/kiosk/
COPY apps/cashier/package.json apps/cashier/
COPY apps/display/package.json apps/display/

RUN npm ci

COPY apps/kiosk apps/kiosk
COPY apps/cashier apps/cashier
COPY apps/display apps/display

# URL relativa al mismo origen: nginx hace de proxy hacia el API.
ARG VITE_API_URL=/api
ARG VITE_MEDIA_URL=/media
ARG CASHIER_BASE=/caja/
ARG DISPLAY_BASE=/pantalla/

ENV VITE_API_URL=$VITE_API_URL \
    VITE_MEDIA_URL=$VITE_MEDIA_URL

RUN npm run build --workspace @turnero/kiosk \
 && VITE_BASE=$CASHIER_BASE npm run build --workspace @turnero/cashier \
 && VITE_BASE=$DISPLAY_BASE npm run build --workspace @turnero/display

# ------------------------- etapa 2: runtime -------------------------
FROM nginx:1.27-alpine AS runtime

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/kiosk/dist   /usr/share/nginx/html/kiosk
COPY --from=build /app/apps/cashier/dist /usr/share/nginx/html/caja
COPY --from=build /app/apps/display/dist /usr/share/nginx/html/pantalla

EXPOSE 80
