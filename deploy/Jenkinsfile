// =============================================================================
// Pipeline de despliegue del turnero.
// Todo corre en el mismo servidor: Jenkins construye las imagenes y levanta
// el stack con docker compose. No se usa registry externo.
//
// Requisitos en el agente:
//   - Docker Engine + plugin `docker compose`
//   - `curl`
//   - Credencial Jenkins tipo Secret file, ID `turnero-prod-env`, con el .env de produccion
// =============================================================================
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(false)
    }

    environment {
        COMPOSE_FILE = "deploy/docker-compose.yml"
        ENV_FILE     = "deploy/.env"
        DOMAIN       = "turnero.serviredgane.cloud"
    }

    stages {
        stage('Preparar') {
            steps {
                sh 'docker version'
                sh 'docker compose version'
                withCredentials([file(credentialsId: 'turnero-prod-env', variable: 'DEPLOY_ENV_CREDENTIAL')]) {
                    sh '''
                        install -m 600 "${DEPLOY_ENV_CREDENTIAL}" "${ENV_FILE}"
                    '''
                }
            }
        }

        stage('Build imagenes') {
            steps {
                sh "docker compose -f ${COMPOSE_FILE} --env-file ${ENV_FILE} build --pull"
            }
        }

        stage('Desplegar') {
            steps {
                sh "docker compose -f ${COMPOSE_FILE} --env-file ${ENV_FILE} up -d --remove-orphans"
            }
        }

        stage('Verificar') {
            steps {
                // El servicio `web` no publica puertos en el host: comprobamos el
                // health del API a traves de nginx, desde dentro de la red
                // `red-gane-int` (busybox wget viene en nginx:alpine).
                sh '''
                    for i in $(seq 1 40); do
                      if docker compose -f ${COMPOSE_FILE} --env-file ${ENV_FILE} exec -T web wget -qO- http://localhost/api/health; then
                        echo ""
                        echo "API OK a traves de nginx"
                        exit 0
                      fi
                      sleep 3
                    done
                    echo "El API no respondio a tiempo"
                    docker compose -f ${COMPOSE_FILE} --env-file ${ENV_FILE} ps || true
                    docker compose -f ${COMPOSE_FILE} --env-file ${ENV_FILE} logs --tail=120 api || true
                    docker compose -f ${COMPOSE_FILE} --env-file ${ENV_FILE} logs --tail=60 web || true
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "Desplegado en https://${env.DOMAIN} (kiosco /, caja /caja/, pantalla /pantalla/)"
            archiveArtifacts artifacts: 'deploy/**', excludes: 'deploy/.env', allowEmptyArchive: true
        }
        failure {
            sh '''
                if [ -f "${ENV_FILE}" ]; then
                  docker compose -f "${COMPOSE_FILE}" --env-file "${ENV_FILE}" ps || true
                  docker compose -f "${COMPOSE_FILE}" --env-file "${ENV_FILE}" logs --tail=150 || true
                else
                  echo "Se omite el diagnostico de Compose: ${ENV_FILE} ya no esta disponible."
                fi
            '''
        }
        always {
            sh 'rm -f "${ENV_FILE}"'
            sh 'docker image prune -f || true'
        }
    }
}
